# Example configuration file for Streamlit UI
# Copy this file to .streamlit/secrets.toml and fill in your values
APP_PASSWORD = "your_secure_password"

# ---------------------------------------------------------------------------
# API Server authentication (REQUIRED)
# The FastAPI server (/api/v1/*) rejects all requests without a valid key.
# Set this as an environment variable before starting the API server:
#   export QUANT_API_KEY="your_api_key_here"
# All /api/v1/* routes return HTTP 401 if the X-API-Key header is missing
# or doesn't match. The root GET / health check is exempt.
# ---------------------------------------------------------------------------
QUANT_API_KEY = "your_api_key_here"
