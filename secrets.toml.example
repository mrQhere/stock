# Template for .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your value.
#
#   cp secrets.toml.example .streamlit/secrets.toml
#
# The .streamlit/ directory is in .gitignore — this file will never be
# committed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Dashboard login password (required to unlock the Streamlit UI).
# If this file is missing entirely, the dashboard opens without any password.
APP_PASSWORD = "your_secure_password_here"

# ─────────────────────────────────────────────────────────────────────────────
# QUANT_API_KEY is NOT read from this file.
# The FastAPI server reads it exclusively from the environment:
#
#   export QUANT_API_KEY="your_api_key_here"
#
# All /api/v1/* routes return HTTP 401 if the X-API-Key header is missing
# or doesn't match. The root GET / health check is always exempt.
# ─────────────────────────────────────────────────────────────────────────────
